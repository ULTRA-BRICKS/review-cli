#!/usr/bin/env python3
"""review-remote — run `review diff` on another host and bring the report (and gate record) back.

The local box has ONE host-wide review admission queue; when it is long, run the same review on
`home` (laptop) or `clvm` (65.21.40.51) instead. Nothing is pushed to any remote repository:

  1. a snapshot (`git archive`) of the base commit travels over ssh into a scratch dir on the
     host (`~/.cache/review-remote/<job>/wt`), committed there with the real `origin` URL so
     review-cli's repo identity matches;
  2. the exact diff (`git diff --cached` or `git diff A B`) is applied to it and staged, so the
     seats see the same files and the same diff the local run would;
  3. `review diff --staged ...` runs there (its own admission queue, its own seats), its output
     streams back;
  4. with --record-local the remote run's run-stats record(s) are appended to the local
     run-stats.jsonl (tagged `remote_host`), so `review task CODE --check` sees the iteration;
  5. the scratch dir is removed.

Usage:
  review-remote [--host home|clvm|auto|USER@HOST] [--range A..B] [-C DIR] [--record-local]
                [--keep] [--dry-run] [-o FILE] [--] [review diff args: --task CODE --preset ... -m ...]

Default diff = the STAGED diff of -C DIR (like `review diff --staged`). --range A..B reviews
`git diff A B` instead (what a merged PR / a stale-base branch really changed).
Seats a host can run are limited to its logins (`ssh HOST review status`): neither remote host
has a Codex login, so a review that must include Codex needs a separate local `-m codex...` run.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
import tempfile
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

HOSTS = {"home": "home", "clvm": "ultra@65.21.40.51"}
SSH = [
    "ssh",
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=10",
    "-o", "ControlMaster=auto",
    "-o", f"ControlPath={Path.home()}/.cache/review-remote/cm-%C",
    "-o", "ControlPersist=120",
]
REMOTE_PATH = 'export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"'

# Flags review-remote owns; everything else passes through to the remote `review diff`.
DROP_WITH_VALUE = {"-C", "--cwd", "-o", "--output"}
DROP_BARE = {"--staged", "--diff", "--detach"}

RUN_SCRIPT = r"""
set -eu
%(path)s
J=$1; ORIGIN=$2; shift 2
cd "$J/wt"
git init -q
git config user.email review-remote@localhost
git config user.name review-remote
git remote add origin "$ORIGIN"
git add -A -f
git commit -q -m "review-remote snapshot" --no-verify
git apply --index --binary "$J/patch"
echo "[review-remote] $(hostname): snapshot $(git rev-parse --short HEAD), $(git diff --cached --numstat | wc -l) file(s) staged" >&2
set +e
review diff --staged -C "$J/wt" "$@" </dev/null
echo $? > "$J/exit"
exit 0
"""


def die(msg: str, code: int = 2) -> "None":
    print(f"review-remote: {msg}", file=sys.stderr)
    raise SystemExit(code)


def git(repo: str, *args: str, binary: bool = False) -> "str | bytes":
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True)
    if r.returncode != 0:
        die(f"git {' '.join(args)} failed: {r.stderr.decode(errors='replace').strip()}")
    return r.stdout if binary else r.stdout.decode()


def ssh(host: str, remote_cmd: str, **kw) -> subprocess.CompletedProcess:
    return subprocess.run([*SSH, host, remote_cmd], **kw)


def probe(host: str) -> tuple[float, str] | None:
    """(load score, summary) for auto-selection; None when unreachable. Lower = emptier."""
    script = (
        f'{REMOTE_PATH}; read l _ < /proc/loadavg; n=$(nproc); '
        'u=$(review status 2>/dev/null | sed -n "3,16p" | grep -c " usable$"); '
        'out=$(review jobs --slots 2>/dev/null | grep -m1 "reviews:"); echo "$l $n $u | $out"'
    )
    try:
        r = ssh(host, script, capture_output=True, text=True, timeout=40)
    except subprocess.TimeoutExpired:
        return None
    if r.returncode != 0 or "|" not in r.stdout:
        return None
    head, _, tail = r.stdout.partition("|")
    try:
        load, ncpu, usable = head.split()
        if int(usable) < 2:  # fewer than two usable seats cannot make a quorum
            return None
        running = waiting = 0
        if "running" in tail:
            words = tail.replace(",", " ").split()
            running = int(words[words.index("running") - 1])
            waiting = int(words[words.index("waiting") - 1]) if "waiting" in words else 0
        score = waiting * 3 + running + float(load) / float(ncpu) * 4
    except (ValueError, IndexError):
        return None
    return score, f"load {load}/{ncpu}cpu,{tail.strip() or 'reviews: ?'}"


def pick_host(spec: str) -> str:
    if spec in HOSTS:
        return HOSTS[spec]
    if spec != "auto":
        return spec
    best: tuple[float, str] | None = None
    for name, host in HOSTS.items():
        p = probe(host)
        print(f"[review-remote] probe {name}: {p[1] if p else 'skipped (unreachable or <2 usable seats; see `ssh HOST review status`)'}", file=sys.stderr)
        if p and (best is None or p[0] < best[0]):
            best = (p[0], host)
    if best is None:
        die("no remote host reachable", 3)
    return best[1]


def split_args(rest: list[str]) -> tuple[list[str], str | None, str | None]:
    """Passthrough args for `review diff`, plus the local -o target and the --task code."""
    out: list[str] = []
    output = task = None
    i = 0
    while i < len(rest):
        a = rest[i]
        flag, eq, val = a.partition("=")
        if flag in DROP_WITH_VALUE:
            if not eq:
                i += 1
                val = rest[i] if i < len(rest) else ""
            if flag in ("-o", "--output"):
                output = val
        elif a in DROP_BARE:
            pass
        else:
            out.append(a)
            if flag == "--task":
                if eq:
                    task = val
                elif i + 1 < len(rest):
                    task = rest[i + 1]
        i += 1
    return out, output, task


def load_waiting_job(job_id: str) -> dict:
    p = Path.home() / ".cache/review-cli/jobs" / f"{job_id}.json"
    try:
        data = json.loads(p.read_text())
    except (OSError, ValueError):
        die(f"no such detached job: {job_id}")
    if data.get("status") != "running" or data.get("admission") != "waiting":
        die(f"job {job_id} is not waiting in the admission queue (status={data.get('status')}, "
            f"admission={data.get('admission')}); leave it to run locally")
    if data.get("argv", [None])[0] != "diff":
        die("only `review diff` jobs can be taken over")
    return data


def load_job_safe(job_id: str) -> dict | None:
    try:
        return json.loads((Path.home() / ".cache/review-cli/jobs" / f"{job_id}.json").read_text())
    except (OSError, ValueError):
        return None


def finish_job(job: dict, rc: int, host: str, report: str | None) -> None:
    """Retire the local queue entry of a job whose review ran remotely: stop the waiting
    process, then mark the job record done so `review wait/status` and the agent that is
    polling its result file see a finished job. Does nothing when the local run got admitted
    in the meantime (the local run then wins)."""
    jid, pid = job["job_id"], job.get("pid")
    now = load_job_safe(jid)
    if now is None or now.get("admission") != "waiting":
        print(f"[review-remote] job {jid} was admitted locally meanwhile; left running", file=sys.stderr)
        return
    if isinstance(pid, int):
        try:
            cmd = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode()
        except OSError:
            cmd = ""
        if "reviewlib" in cmd or "review" in cmd:
            try:
                os.kill(pid, 15)
            except PermissionError:
                print(f"[review-remote] cannot signal pid {pid} from this environment: job {jid} stays queued "
                      f"and will still run locally; the remote report is at {report}", file=sys.stderr)
                return
            for _ in range(40):
                if not Path(f"/proc/{pid}").exists():
                    break
                time.sleep(0.25)
    review_src = Path(os.path.realpath(Path.home() / ".local/bin/review")).parent.parent
    sys.path.insert(0, str(review_src))
    from reviewlib import jobs  # type: ignore[import-not-found]

    jobs.write_job(
        jid,
        status="done" if rc == 0 else "failed",
        exit_code=rc,
        finished_at=time.time(),
        admission=f"ran-remotely:{host}",
        queue_position=0,
    )
    if report and Path(report).exists():
        Path(report).replace(job["result_path"])
    print(f"[review-remote] job {jid}: local queue entry cancelled, marked done (exit {rc})", file=sys.stderr)


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--host", default="auto")
    ap.add_argument("--range", dest="rng")
    ap.add_argument("-C", dest="cwd", default=".")
    ap.add_argument("--record-local", action="store_true")
    ap.add_argument("--keep", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--take-job", metavar="JOB_ID", help="take over a WAITING detached local job (see `review jobs`)")
    ap.add_argument("-o", "--output", dest="output")
    ap.add_argument("rest", nargs=argparse.REMAINDER)
    ns = ap.parse_args()
    rest = ns.rest[1:] if ns.rest[:1] == ["--"] else ns.rest
    job: dict | None = None
    if ns.take_job:
        job = load_waiting_job(ns.take_job)
        jargv = job["argv"][1:]
        rv_args, out_file, task = split_args(jargv)
        ns.cwd = job["cwd"]
        for i, a in enumerate(jargv):
            if a in ("-C", "--cwd") and i + 1 < len(jargv):
                ns.cwd = str((Path(job["cwd"]) / jargv[i + 1]).resolve())
        out_file = str(job["result_path"]) + ".remote"
        ns.record_local = True
    else:
        rv_args, out_file, task = split_args(rest)
        out_file = ns.output or out_file
    task = task or os.environ.get("REVIEW_TASK_CODE")
    if "--task" not in rv_args and task:
        rv_args += ["--task", task]

    repo = str(git(ns.cwd, "rev-parse", "--show-toplevel")).strip()
    origin = str(git(repo, "remote", "get-url", "origin")).strip()
    if ns.rng:
        three = "..." in ns.rng
        a, sep, b = ns.rng.partition("..." if three else "..")
        if not sep or not a or not b:
            die("--range wants A..B or A...B (A...B = merge-base(A,B)..B, no stale-base noise)")
        head = str(git(repo, "rev-parse", f"{b}^{{commit}}")).strip()
        base = str(git(repo, "rev-parse", f"{a}^{{commit}}")).strip()
        if three:
            base = str(git(repo, "merge-base", base, head)).strip()
        patch = git(repo, "diff", "--binary", base, head, binary=True)
    else:
        base = str(git(repo, "rev-parse", "HEAD")).strip()
        patch = git(repo, "diff", "--cached", "--binary", binary=True)
    if not patch:
        die("empty diff: nothing staged (git add the change, or pass --range A..B)")

    host = pick_host(ns.host)
    rjob = f"{time.strftime('%Y%m%dT%H%M%S')}-{uuid.uuid4().hex[:6]}"
    jdir = f".cache/review-remote/{rjob}"  # relative to remote $HOME
    print(
        f"[review-remote] host={host} repo={Path(repo).name} base={base[:9]} "
        f"diff={len(patch)} bytes job={rjob} args={' '.join(rv_args) or '(default board)'}",
        file=sys.stderr,
    )
    if ns.dry_run:
        return 0

    t0 = datetime.now(timezone.utc)
    Path.home().joinpath(".cache/review-remote").mkdir(parents=True, exist_ok=True)
    # 1+2: snapshot + patch
    tar = subprocess.Popen(["git", "-C", repo, "archive", "--format=tar", base], stdout=subprocess.PIPE)
    r = ssh(host, f'mkdir -p "$HOME/{jdir}/wt" && tar -x -C "$HOME/{jdir}/wt"', stdin=tar.stdout)
    tar.stdout.close()
    if tar.wait() != 0 or r.returncode != 0:
        die("snapshot upload failed", 4)
    r = ssh(host, f'cat > "$HOME/{jdir}/patch"', input=patch)
    if r.returncode != 0:
        die("patch upload failed", 4)

    # 3: run (stdout/stderr stream through)
    cmd = f'bash -s -- "$HOME/{jdir}" {shlex.quote(origin)} ' + " ".join(shlex.quote(a) for a in rv_args)
    script = RUN_SCRIPT % {"path": REMOTE_PATH}
    with tempfile.TemporaryFile() as captured:
        p = subprocess.Popen([*SSH, host, cmd], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=sys.stderr)
        assert p.stdin and p.stdout
        p.stdin.write(script.encode())
        p.stdin.close()
        for chunk in iter(lambda: p.stdout.read(4096), b""):
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
            captured.write(chunk)
        ssh_rc = p.wait()
        if out_file:
            captured.seek(0)
            Path(out_file).expanduser().parent.mkdir(parents=True, exist_ok=True)
            Path(out_file).expanduser().write_bytes(captured.read())

    exit_r = ssh(host, f'cat "$HOME/{jdir}/exit" 2>/dev/null', capture_output=True, text=True)
    try:
        rc = int(exit_r.stdout.strip())
    except ValueError:
        rc = ssh_rc or 1
        print("[review-remote] remote exit code unreadable; the run did not finish", file=sys.stderr)

    # 4: bring the gate record(s) home — but only while the local queue entry is still waiting;
    # a job the local queue admitted meanwhile keeps its own run, result file and record.
    if job is not None and (load_job_safe(job["job_id"]) or {}).get("admission") != "waiting":
        print(f"[review-remote] job {job['job_id']} was admitted locally meanwhile: local run wins; "
              f"remote report left at {out_file}, nothing recorded or overwritten", file=sys.stderr)
        job = None
    elif ns.record_local:
        n = import_records(host, t0, task)
        print(f"[review-remote] recorded {n} run-stats record(s) locally (remote_host={host})", file=sys.stderr)
    if job is not None:
        finish_job(job, rc, host, out_file)

    # 5: cleanup
    if not ns.keep:
        ssh(host, f'rm -rf "$HOME/{jdir}"')
    else:
        print(f"[review-remote] kept {host}:~/{jdir}", file=sys.stderr)
    return rc


def import_records(host: str, since: datetime, task: str | None) -> int:
    r = ssh(host, 'tail -n 200 "$HOME/.config/review-cli/run-stats.jsonl"', capture_output=True, text=True)
    local = Path(os.environ.get("REVIEW_STATS_FILE") or Path.home() / ".config/review-cli/run-stats.jsonl").expanduser()
    existing = local.read_text() if local.exists() else ""
    fresh: list[str] = []
    for line in r.stdout.splitlines():
        try:
            rec = json.loads(line)
            ts = datetime.fromisoformat(rec["ts"])
        except (ValueError, KeyError):
            continue
        if ts < since or (task and rec.get("task_code") != task) or not rec.get("task_code"):
            continue
        rec["remote_host"] = host
        out = json.dumps(rec, separators=(",", ":"))
        if out not in existing:
            fresh.append(out)
    if fresh:
        fd = os.open(str(local), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            os.write(fd, ("\n".join(fresh) + "\n").encode())
        finally:
            os.close(fd)
    return len(fresh)


if __name__ == "__main__":
    raise SystemExit(main())
